{
        admin off
        persist_config off
        auto_https off

        log {
                format json
        }

        servers {
                trusted_proxies static private_ranges
        }
}

:{$PORT:80} {
        log {
                format json
        }

        respond /health 200


        header {
                X-XSS-Protection "1; mode=block"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
                Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
                -Server
        }

        # When we remove the redirect above, force the SPA shell to revalidate
        # so the HTML entrypoint cannot lag behind newly deployed asset chunks.
        @spa_shell path / /index.html /sandbox*
        header @spa_shell Cache-Control "no-cache, no-store, must-revalidate"
        header @spa_shell Pragma "no-cache"
        header @spa_shell Expires "0"

        root * /app
        encode gzip zstd

        try_files {path} /index.html

        file_server {
                hide .git
                hide .env*
        }
}
